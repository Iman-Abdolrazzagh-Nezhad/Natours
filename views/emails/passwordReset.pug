extends baseEmail 

block content 
    p Hi #{firstName},
        p Did you forgot your password? 
        | There has been a submit of password forgot in your Natours.com account, 
        | if it was you who made the request please go here : #{url} for further instructions, 

        p This button is not functional yet!
         

        table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
                tr
                    td(align='left')
                        table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                            tbody
                                tr
                                    td
                                        a(href=`${url}`, target='_blank') Reset your password

        p Otherwise please ignore this email.
